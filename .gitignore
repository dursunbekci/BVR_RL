# Python bytecode: regenerated on every run, and differs per Python version.
__pycache__/
*.py[cod]

# Training outputs. Models are large, change every run and belong to the
# machine that trained them.
models_bvr/*.zip
models_bvr/selfplay_pool/

# Cross-play evaluation output
crossplay_results/

# Live training metrics for the GUI, rewritten every 10 episodes
bvr_metrics.json

# DCS input check output (dcs_obs_check.py)
dcs_check/

# Intermediate pages written by docs/guide/build.py
docs/guide/_*.html

# WATCH fight records (bvr_gui.py, one line per fight)
watch_runs/

# DCS live runs (dcs_live.py) and generated missions
dcs_runs/
dcs/*.miz
